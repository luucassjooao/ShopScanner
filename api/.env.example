# Copie para .env e preencha. O .env nunca vai para o git.
NODE_ENV=development
PORT=3333
# Interface em que a API escuta. 127.0.0.1: só esta máquina. 0.0.0.0: a rede toda (contêiner).
HOST=127.0.0.1

# Em quem confiar no X-Forwarded-For (decide o IP do rate limit e da sessão).
# false: a API recebe direto. Senão, os IPs ou faixas dos proxies, separados por vírgula
# (ex.: 10.0.0.5 ou 10.0.0.0/8, ou uniquelocal para a rede privada do provedor).
# "true" e número de saltos são recusados. Obrigatória em produção.
TRUST_PROXY=false

# Postgres. Com docker compose o host é o nome do serviço: db
DATABASE_URL=postgres://shopscanner:shopscanner@localhost:5432/shopscanner

# 32+ caracteres aleatórios. Gere com: openssl rand -base64 32
JWT_SECRET=
REFRESH_TOKEN_PEPPER=

# 32 bytes em base64, para AES-256-GCM dos tokens do TikTok.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Domínio dos cookies de sessão (localhost em desenvolvimento)
COOKIE_DOMAIN=localhost

# Origem do front, única permitida no CORS
WEB_ORIGIN=http://localhost:5173

# Login com Google (opcional). Credenciais do console do Google Cloud.
# O redirect precisa bater com o cadastrado lá: <API>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback

# Conexão com o TikTok (opcional). Credenciais do app em developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3333/connections/tiktok/callback
# Pedidos do TikTok Shop: só ligar quando a Affiliate Creator API liberar o Brasil
TIKTOK_SHOP_ENABLED=false
